$C = "../Common.ui";
Group {
  Anchor: (Width: 398, Height: 420, Bottom: 8);
  LayoutMode: Top;
  Padding: (Full: 10);
  Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 8);

  Group {
    Anchor: (Height: 72, Bottom: 8);
    LayoutMode: Left;

    Group #Icon {
      Anchor: (Width: 64, Height: 64);
      Background: (TexturePath: "Common/UI/WorldMap/MapMarkers/Player.png");
    }

    Group { Anchor: (Width: 10); }

    Group {
      FlexWeight: 1;
      LayoutMode: Top;

      Label #PetName {
        Text: "Pet";
        Anchor: (Height: 24);
        Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f2ebdb, HorizontalAlignment: Start, VerticalAlignment: Center);
      }

      Label #PetRole {
        Text: "Role";
        Anchor: (Height: 20);
        Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a9c0d8, HorizontalAlignment: Start, VerticalAlignment: Center);
      }
    }
  }

  Label {
    Text: "Presets";
    Anchor: (Height: 16, Bottom: 6);
    Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8ea5bb, HorizontalAlignment: Start, RenderUppercase: true);
  }

  Group #RoleGrid {
    Anchor: (Height: 210, Bottom: 10);
    LayoutMode: TopScrolling;
    ScrollbarStyle: $C.@TranslucentScrollbarStyle;
    Padding: (Left: 2, Right: 2, Top: 2, Bottom: 2);
    Background: (Color: #0f1a2d);
  }

  Group #CustomRoleInputWrap {
    LayoutMode: Top;
    Anchor: (Height: 40, Bottom: 8);
    Background: (Color: #161e2b);
    Padding: (Full: 2);

    TextField #CustomRoleInput {
      PlaceholderText: "Type custom role id...";
      Anchor: (Height: 36);
      Style: (FontSize: 13, TextColor: #d4dfe8);
      PlaceholderStyle: (TextColor: #7a90a8, FontSize: 13);
      Background: (Color: #00000000);
      Padding: (Horizontal: 12, Vertical: 9);
    }
  }

  $C.@SecondaryTextButton #CustomRoleApply {
    @Anchor = (Height: 32);
    Text: "APPLY CUSTOM ROLE";
  }
}

