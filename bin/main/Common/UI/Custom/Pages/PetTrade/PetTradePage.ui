$C = "../../Common.ui";
$C.@PageOverlay #TradeRoot {
  LayoutMode: Middle;

  Group #TradePanel {
    Anchor: (Width: 1220, Height: 900);
    LayoutMode: Top;
    Padding: (Full: 20);
    Background: (TexturePath: "../../Common/ContainerFullPatch.png", Border: 20);

    Label #TradeTitle {
      Text: "Pet Trade";
      Anchor: (Height: 40, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 32, RenderBold: true, TextColor: #d9e5f2, HorizontalAlignment: Center);
    }

    Label #TradeSubtitle {
      Text: "Offer pets and coins, then ready up.";
      Anchor: (Height: 20, Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8bed3, HorizontalAlignment: Center);
    }

    Group #Content {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 14);
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 10);

      Group #TopRow {
        LayoutMode: Left;
        Anchor: (Height: 220, Bottom: 10);

        Group #YourOfferPanel {
          LayoutMode: Top;
          Anchor: (Width: 588);
          Padding: (Full: 10);
          Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

          Label #YourName {
            Anchor: (Height: 22, Bottom: 6);
            Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #9ee8d1, HorizontalAlignment: Start, VerticalAlignment: Center);
            Text: "You";
          }

          Group #YourOfferList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Anchor: (Height: 146, Bottom: 8);
          }

          Label #YourStatus {
            Anchor: (Height: 18);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c6d2ff, HorizontalAlignment: Start);
            Text: "NOT READY";
          }

          Label #YourMoney {
            Anchor: (Height: 18);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9cb2c7, HorizontalAlignment: Start);
            Text: "Money: $0";
          }
        }

        Group { Anchor: (Width: 10); }

        Group #TheirOfferPanel {
          LayoutMode: Top;
          Anchor: (Width: 588);
          Padding: (Full: 10);
          Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

          Label #TheirName {
            Anchor: (Height: 22, Bottom: 6);
            Style: (...$C.@DefaultLabelStyle, FontSize: 14, RenderBold: true, TextColor: #ffd37d, HorizontalAlignment: Start, VerticalAlignment: Center);
            Text: "Partner";
          }

          Group #TheirOfferList {
            LayoutMode: TopScrolling;
            ScrollbarStyle: $C.@DefaultScrollbarStyle;
            Anchor: (Height: 146, Bottom: 8);
          }

          Label #TheirStatus {
            Anchor: (Height: 18);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c6d2ff, HorizontalAlignment: Start);
            Text: "NOT READY";
          }

          Label #TheirMoney {
            Anchor: (Height: 18);
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9cb2c7, HorizontalAlignment: Start);
            Text: "Money: $0";
          }
        }
      }

      Group #SearchRow {
        LayoutMode: Left;
        Anchor: (Height: 42, Bottom: 10);

        Group #SearchWrapper {
          FlexWeight: 1;
          Anchor: (Height: 42);
          Background: (Color: #161e2b);
          Padding: (Full: 2);

          TextField #SearchInput {
            PlaceholderText: "Search tradable pets...";
            Style: (FontSize: 15, TextColor: #d4dfe8);
            PlaceholderStyle: (TextColor: #4a5d75, FontSize: 15);
            Background: (Color: #00000000);
            Padding: (Horizontal: 14, Vertical: 10);
          }
        }

        Group { Anchor: (Width: 10); }

        Label #AvailableCount {
          Anchor: (Width: 150, Height: 42);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8ea1b7, HorizontalAlignment: End, VerticalAlignment: Center, RenderUppercase: true);
          Text: "0 AVAILABLE";
        }
      }

      Group #AvailablePanel {
        LayoutMode: Top;
        FlexWeight: 1;
        Anchor: (Bottom: 10);
        Padding: (Full: 10);
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

        Label #AvailableTitle {
          Anchor: (Height: 20, Bottom: 8);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #c6d2ff, HorizontalAlignment: Start);
          Text: "Select pets to offer";
        }

        Group #AvailablePetsContainer {
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
          FlexWeight: 1;

          Group #AvailableColumns {
            LayoutMode: Left;
            Padding: (Horizontal: 4);

            Group #AvailableColumn0 {
              LayoutMode: Top;
              Anchor: (Width: 392);
              Padding: (Right: 6);
            }

            Group #AvailableColumn1 {
              LayoutMode: Top;
              Anchor: (Width: 392);
              Padding: (Horizontal: 6);
            }

            Group #AvailableColumn2 {
              LayoutMode: Top;
              Anchor: (Width: 392);
              Padding: (Left: 6);
            }
          }
        }
      }

      Group #MoneyPanel {
        LayoutMode: Top;
        Anchor: (Height: 132, Bottom: 10);
        Padding: (Full: 10);
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

        Group {
          LayoutMode: Center;
          Anchor: (Height: 20, Bottom: 2);

          Label {
            Anchor: (Width: 120, Height: 20, Right: 8);
            Style: (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 13, TextColor: #c6d2ff, HorizontalAlignment: End);
            Text: "Money Offer";
          }

          Label #MoneyAmount {
            Anchor: (Height: 20);
            Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #8efac2, HorizontalAlignment: Start);
            Text: "$0";
          }
        }

        Label #MoneyBalance {
          Anchor: (Height: 16, Bottom: 6);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9cb2c7, HorizontalAlignment: Center, VerticalAlignment: Center);
          Text: "Balance: $0";
        }

        Group {
          LayoutMode: Center;
          Anchor: (Height: 28, Bottom: 4);

          TextButton #MoneyMinus10 { Anchor: (Width: 62, Height: 28, Right: 6); Style: (...$C.@SecondaryTextButtonStyle); Text: "-10"; }
          TextButton #MoneyMinus100 { Anchor: (Width: 66, Height: 28, Right: 6); Style: (...$C.@SecondaryTextButtonStyle); Text: "-100"; }
          TextButton #MoneyMinus1000 { Anchor: (Width: 72, Height: 28, Right: 6); Style: (...$C.@SecondaryTextButtonStyle); Text: "-1000"; }
          TextButton #MoneyMinus10000 { Anchor: (Width: 80, Height: 28); Style: (...$C.@SecondaryTextButtonStyle); Text: "-10000"; }
        }

        Group {
          LayoutMode: Center;
          Anchor: (Height: 28);

          TextButton #MoneyPlus10 { Anchor: (Width: 62, Height: 28, Right: 6); Style: (...$C.@SecondaryTextButtonStyle); Text: "+10"; }
          TextButton #MoneyPlus100 { Anchor: (Width: 66, Height: 28, Right: 6); Style: (...$C.@SecondaryTextButtonStyle); Text: "+100"; }
          TextButton #MoneyPlus1000 { Anchor: (Width: 72, Height: 28, Right: 6); Style: (...$C.@SecondaryTextButtonStyle); Text: "+1000"; }
          TextButton #MoneyPlus10000 { Anchor: (Width: 80, Height: 28); Style: (...$C.@SecondaryTextButtonStyle); Text: "+10000"; }
        }
      }

      Group #ActionsRow {
        LayoutMode: Center;
        Anchor: (Height: 42);

        TextButton #ReadyButton {
          Anchor: (Width: 160, Height: 38, Right: 10);
          Style: (...$C.@DefaultTextButtonStyle);
          Text: "READY";
        }

        TextButton #CancelButton {
          Anchor: (Width: 140, Height: 38);
          Style: (...$C.@CancelTextButtonStyle);
          Text: "CANCEL";
        }

        Label #CountdownLabel {
          Anchor: (Height: 38, Left: 12);
          Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #ffd48a, HorizontalAlignment: Start, VerticalAlignment: Center);
          Text: "";
          Visible: false;
        }
      }
    }
  }
}

$C.@BackButton {}

