$C = "../../Common.ui";
Group {
  Anchor: (Height: 62, Bottom: 6);
  LayoutMode: Left;
  Padding: (Left: 10, Right: 8, Top: 8, Bottom: 8);
  Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

  Group #Icon {
    Anchor: (Width: 36, Height: 36);
    Background: (TexturePath: "Common/UI/WorldMap/MapMarkers/Player.png");
  }

  Group { Anchor: (Width: 10); }

  Group {
    FlexWeight: 1;
    LayoutMode: Top;

    Label #PetName {
      Anchor: (Height: 18);
      Style: (...$C.@DefaultLabelStyle, FontSize: 13, TextColor: #f2ebdb, RenderBold: true, HorizontalAlignment: Start, VerticalAlignment: Center);
      Text: "pet";
    }

    Label #PetMeta {
      Anchor: (Height: 16);
      Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9ab6d3, HorizontalAlignment: Start, VerticalAlignment: Center);
      Text: "Lvl 1 | P0 | XP 0/100";
    }
  }

  $C.@SecondaryTextButton #RemoveButton {
    @Anchor = (Width: 98, Height: 30);
    Text: "REMOVE";
  }
}



