$C = "../Common.ui";
$C.@PageOverlay #PetsRoot {
  LayoutMode: Middle;

  Group #PetsPanel {
    Anchor: (Width: 1120, Height: 820);
    LayoutMode: Top;
    Padding: (Full: 20);
    Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 20);

    Label #Title {
      Text: "YOUR PETS";
      Anchor: (Height: 44, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 34, RenderBold: true, TextColor: #d9e5f2, HorizontalAlignment: Center, RenderUppercase: true);
    }

    Label #Subtitle {
      Text: "Select a pet to spawn";
      Anchor: (Height: 20, Bottom: 12);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8bed3, HorizontalAlignment: Center, RenderUppercase: true);
    }

    Group #Content {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 14);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 10);

      Group #SearchRow {
        LayoutMode: Left;
        Anchor: (Height: 42, Bottom: 10);

        Group #SearchWrapper {
          FlexWeight: 1;
          Anchor: (Height: 42);
          Background: (Color: #161e2b);
          Padding: (Full: 2);

          TextField #SearchInput {
            PlaceholderText: "Search pets...";
            Style: (FontSize: 15, TextColor: #d4dfe8);
            PlaceholderStyle: (TextColor: #4a5d75, FontSize: 15);
            Background: (Color: #00000000);
            Padding: (Horizontal: 14, Vertical: 10);
          }
        }

        Group { Anchor: (Width: 10); }

        $C.@SecondaryTextButton #TradeHintBtn {
          @Anchor = (Width: 180, Height: 38);
          Text: "/pet trade";
          Disabled: true;
        }
      }

      Group #ToggleRow {
        LayoutMode: Left;
        Anchor: (Height: 30, Bottom: 12);

        $C.@CheckBoxWithLabel #AutoRespawnToggle {
          @Text = "Auto respawn active pet";
        }

        Group { Anchor: (Width: 18); }

        $C.@CheckBoxWithLabel #HidePetVisualToggle {
          @Text = "Hide active pet model (buff stays active)";
        }
      }

      Group #PetListContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 10);

        Group #PetColumns {
          LayoutMode: Left;
          Padding: (Horizontal: 4);

          Group #PetColumn0 {
            LayoutMode: Top;
            Anchor: (Width: 350);
            Padding: (Right: 6);
          }

          Group #PetColumn1 {
            LayoutMode: Top;
            Anchor: (Width: 350);
            Padding: (Horizontal: 6);
          }

          Group #PetColumn2 {
            LayoutMode: Top;
            Anchor: (Width: 350);
            Padding: (Left: 6);
          }
        }
      }

      Group #Footer {
        Anchor: (Height: 40, Top: 10);
        LayoutMode: Left;

        Label #PetCount {
          Text: "0 PETS OWNED";
          FlexWeight: 1;
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8ea5bb, HorizontalAlignment: End, VerticalAlignment: Center, RenderUppercase: true);
        }
      }
    }
  }
}

$C.@BackButton {}



