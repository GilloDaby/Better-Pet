$C = "../../Common.ui";
$C.@PageOverlay #UpgradeRoot {
  LayoutMode: Middle;

  Group #UpgradePanel {
    Anchor: (Width: 1180, Height: 860);
    LayoutMode: Top;
    Padding: (Full: 20);
    Background: (TexturePath: "../../Common/ContainerFullPatch.png", Border: 20);

    Label #Title {
      Text: "PET UPGRADE";
      Anchor: (Height: 40, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 32, RenderBold: true, TextColor: #d9e5f2, HorizontalAlignment: Center, RenderUppercase: true);
    }

    Label #Subtitle {
      Text: "pet";
      Anchor: (Height: 20, Bottom: 10);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8bed3, HorizontalAlignment: Center, RenderUppercase: true);
    }

    Group #Body {
      FlexWeight: 1;
      LayoutMode: Left;
      Padding: (Full: 14);
      Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 10);

      Group #LeftPanel {
        Anchor: (Width: 280);
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

        Label {
          Text: "YOUR PETS";
          Anchor: (Height: 20, Bottom: 8);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, RenderBold: true, TextColor: #9bb4cf, RenderUppercase: true, HorizontalAlignment: Start);
        }

        Group #PetList {
          FlexWeight: 1;
          LayoutMode: TopScrolling;
          ScrollbarStyle: $C.@DefaultScrollbarStyle;
        }
      }

      Group { Anchor: (Width: 12); }

      Group #RightPanel {
        FlexWeight: 1;
        LayoutMode: Top;
        Padding: (Full: 12);
        Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

        Group #SummaryRow {
          Anchor: (Height: 62, Bottom: 8);
          LayoutMode: Left;

          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Label { Text: "Level"; Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8ca1ba, RenderUppercase: true); }
            Label #LevelValue { Text: "Level 1 / 50"; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f2ebdb); }
          }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Label { Text: "Prestige"; Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8ca1ba, RenderUppercase: true); }
            Label #PrestigeValue { Text: "Prestige 0"; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #f2ebdb); }
          }

          Group {
            FlexWeight: 1;
            LayoutMode: Top;
            Label { Text: "Unspent"; Anchor: (Height: 16); Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8ca1ba, RenderUppercase: true); }
            Label #UnspentValue { Text: "0"; Anchor: (Height: 22); Style: (...$C.@DefaultLabelStyle, FontSize: 18, RenderBold: true, TextColor: #8efac2); }
          }
        }

        Label #PointValue {
          Text: "+0.5%/point";
          Anchor: (Height: 16, Bottom: 6);
          Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8ca1ba, HorizontalAlignment: Start);
        }

        Label #XpText {
          Text: "0 / 100 XP";
          Anchor: (Height: 16);
          Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #a9c0d8, HorizontalAlignment: Start);
        }

        Group #XpProgressBar {
          Anchor: (Width: 420, Height: 10, Bottom: 12, Top: 4);
          LayoutMode: Left;
          Background: #1a2740;

          Group #XpProgressFill {
            Anchor: (Width: 0, Height: 10);
            Background: #52c98a;
          }
        }

        Group { Anchor: (Height: 2, Bottom: 10); Background: #233247; }

        Group #BranchList {
          LayoutMode: Top;
          FlexWeight: 1;

          Group {
            Anchor: (Height: 46, Bottom: 7);
            LayoutMode: Left;
            Padding: (Horizontal: 10, Vertical: 8);
            Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);
            Label { Text: "Mob Drops"; Anchor: (Width: 160); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #f2ebdb, VerticalAlignment: Center); }
            Label #MobValue { Text: "+5% (0 pts)"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9ab6d3, VerticalAlignment: Center); }
            $C.@SecondaryTextButton #MobUpgradeButton { @Anchor = (Width: 114, Height: 30); Text: "UPGRADE"; }
          }

          Group {
            Anchor: (Height: 46, Bottom: 7);
            LayoutMode: Left;
            Padding: (Horizontal: 10, Vertical: 8);
            Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);
            Label { Text: "Money"; Anchor: (Width: 160); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #f2ebdb, VerticalAlignment: Center); }
            Label #MoneyValue { Text: "+0.2% (0 pts)"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9ab6d3, VerticalAlignment: Center); }
            $C.@SecondaryTextButton #MoneyUpgradeButton { @Anchor = (Width: 114, Height: 30); Text: "UPGRADE"; }
          }

          Group {
            Anchor: (Height: 46, Bottom: 7);
            LayoutMode: Left;
            Padding: (Horizontal: 10, Vertical: 8);
            Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);
            Label { Text: "Fishing"; Anchor: (Width: 160); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #f2ebdb, VerticalAlignment: Center); }
            Label #FishingValue { Text: "+5% (0 pts)"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9ab6d3, VerticalAlignment: Center); }
            $C.@SecondaryTextButton #FishingUpgradeButton { @Anchor = (Width: 114, Height: 30); Text: "UPGRADE"; }
          }

          Group {
            Anchor: (Height: 46, Bottom: 7);
            LayoutMode: Left;
            Padding: (Horizontal: 10, Vertical: 8);
            Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);
            Label { Text: "Farming"; Anchor: (Width: 160); Style: (...$C.@DefaultLabelStyle, FontSize: 13, RenderBold: true, TextColor: #f2ebdb, VerticalAlignment: Center); }
            Label #FarmingValue { Text: "+5% (0 pts)"; FlexWeight: 1; Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #9ab6d3, VerticalAlignment: Center); }
            $C.@SecondaryTextButton #FarmingUpgradeButton { @Anchor = (Width: 114, Height: 30); Text: "UPGRADE"; }
          }
        }

        Group { Anchor: (Height: 2, Top: 8, Bottom: 8); Background: #233247; }

        Group {
          Anchor: (Height: 38);
          LayoutMode: Left;

          TextButton #PrestigeButton {
            Anchor: (Width: 170, Height: 34);
            Style: (...$C.@DefaultTextButtonStyle);
            Text: "PRESTIGE";
            Visible: false;
          }

          Group { Anchor: (Width: 8); }

          TextButton #ResetPetButton {
            Anchor: (Width: 170, Height: 34);
            Style: (...$C.@CancelTextButtonStyle);
            Text: "RESET PET";
          }

          Label #PrestigeHint {
            Text: "Prestige available at Level 50";
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #aeb8c2, VerticalAlignment: Center, HorizontalAlignment: Start);
          }
        }
      }
    }

    Group #Footer {
      Anchor: (Height: 46, Top: 10);
      LayoutMode: Left;

      $C.@CancelTextButton #BackButton {
        @Anchor = (Width: 150, Height: 40);
        Text: "RETURN";
      }
    }

    Group #ResetConfirmOverlay {
      Anchor: (Full: 0);
      Background: #00000080;
      LayoutMode: Middle;
      Visible: false;

      Group {
        Anchor: (Width: 680, Height: 360);
        LayoutMode: Top;
        Padding: (Full: 18);
        Background: (TexturePath: "../../Common/ContainerFullPatch.png", Border: 20);

        Label {
          Text: "CONFIRM PET RESET";
          Anchor: (Height: 34, Bottom: 4);
          Style: (...$C.@DefaultLabelStyle, FontSize: 30, RenderBold: true, TextColor: #ff9b9b, HorizontalAlignment: Center, RenderUppercase: true);
        }

        Label {
          Text: "This action is permanent";
          Anchor: (Height: 18, Bottom: 10);
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #c8d4e2, HorizontalAlignment: Center);
        }

        Group {
          FlexWeight: 1;
          LayoutMode: Top;
          Padding: (Full: 12);
          Background: (TexturePath: "../../Common/ContainerPanelPatch.png", Border: 8);

          Label {
            Text: "Pet";
            Anchor: (Height: 16, Bottom: 4);
            Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #8ca1ba, RenderUppercase: true, HorizontalAlignment: Start);
          }

          Label #ResetConfirmPet {
            Text: "pet";
            Anchor: (Height: 24, Bottom: 10);
            Style: (...$C.@DefaultLabelStyle, FontSize: 20, RenderBold: true, TextColor: #f2ebdb, HorizontalAlignment: Start);
          }

          Label #ResetConfirmLoss {
            Text: "You will lose all progress.";
            FlexWeight: 1;
            Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #f0cfcf, Wrap: true, HorizontalAlignment: Start, VerticalAlignment: Start);
          }
        }

        Group {
          Anchor: (Height: 40, Top: 10);
          LayoutMode: Left;

          $C.@SecondaryTextButton #ResetConfirmCancelButton {
            @Anchor = (Width: 170, Height: 36);
            Text: "CANCEL";
          }

          Group { FlexWeight: 1; }

          $C.@CancelTextButton #ResetConfirmButton {
            @Anchor = (Width: 200, Height: 36);
            Text: "CONFIRM RESET";
          }
        }
      }
    }
  }
}


