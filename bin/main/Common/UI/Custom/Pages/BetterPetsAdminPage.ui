$C = "../Common.ui";
$C.@PageOverlay #PetsAdminRoot {
  LayoutMode: Middle;

  Group #PetsAdminPanel {
    Anchor: (Width: 1260, Height: 880);
    LayoutMode: Top;
    Padding: (Full: 20);
    Background: (TexturePath: "../Common/ContainerFullPatch.png", Border: 20);

    Label #Title {
      Text: "PET ROLES";
      Anchor: (Height: 46, Bottom: 4);
      Style: (...$C.@DefaultLabelStyle, FontSize: 36, RenderBold: true, TextColor: #d9e5f2, HorizontalAlignment: Center, RenderUppercase: true);
    }

    Label #Subtitle {
      Text: "Change role behavior for each pet";
      Anchor: (Height: 20, Bottom: 12);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a8bed3, HorizontalAlignment: Center, RenderUppercase: true);
    }

    Group #Content {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Full: 14);
      Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 10);

      Group #SearchRow {
        LayoutMode: Left;
        Anchor: (Height: 44, Bottom: 12);

        Group #SearchWrapper {
          FlexWeight: 1;
          Anchor: (Height: 44);
          Background: (Color: #161e2b);
          Padding: (Full: 2);

          TextField #SearchInput {
            PlaceholderText: "Search pets...";
            Style: (FontSize: 16, TextColor: #d4dfe8);
            PlaceholderStyle: (TextColor: #4a5d75, FontSize: 16);
            Background: (Color: #00000000);
            Padding: (Horizontal: 14, Vertical: 11);
          }
        }

        Group { Anchor: (Width: 10); }

        $C.@SecondaryTextButton #RoleHelpBtn {
          @Anchor = (Width: 220, Height: 40);
          Text: "Role presets";
          Disabled: true;
        }
      }

      Group #PetListContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@DefaultScrollbarStyle;
        Padding: (Left: 8, Right: 8, Top: 8, Bottom: 8);
        Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 10);

        Group #PetColumns {
          LayoutMode: Left;
          Padding: (Horizontal: 4);

          Group #PetColumn0 {
            LayoutMode: Top;
            Anchor: (Width: 398);
            Padding: (Right: 6);
          }

          Group #PetColumn1 {
            LayoutMode: Top;
            Anchor: (Width: 398);
            Padding: (Horizontal: 6);
          }

          Group #PetColumn2 {
            LayoutMode: Top;
            Anchor: (Width: 398);
            Padding: (Left: 6);
          }
        }
      }

      Group #Footer {
        Anchor: (Height: 40, Top: 10);
        LayoutMode: Left;

        Label #PetCount {
          Text: "0 PETS";
          FlexWeight: 1;
          Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #8ea5bb, HorizontalAlignment: End, VerticalAlignment: Center, RenderUppercase: true);
        }
      }
    }
  }
}

$C.@BackButton {}



