$C = "../Common.ui";

Group {
  Background: (Color: #000000(0.75));

  Group {
    Anchor: (Width: 1170, Height: 930);

    Group #TitleBar {
      Anchor: (Height: 105, Top: 0);
      Background: (Color: #0a0f17);

      Group {
        Anchor: (Height: 2, Bottom: 0);
        Background: (Color: #1e2c3f);
      }

      Label #Title {
        Text: "PET ROLES";
        Style: (
          FontSize: 39,
          RenderBold: true,
          TextColor: #d4dfe8,
          RenderUppercase: true,
          HorizontalAlignment: Center,
          VerticalAlignment: Center,
          LetterSpacing: 2
        );
      }
    }

    Group #Content {
      LayoutMode: Top;
      Anchor: (Top: 105, Bottom: 0);
      Background: (Color: #0d1521);
      Padding: (Horizontal: 38, Vertical: 30);

      Group #Header {
        LayoutMode: Top;
        Anchor: (Bottom: 18);

        Label #Subtitle {
          Text: "Change pet roles";
          Style: (
            FontSize: 19,
            TextColor: #7a90a8,
            RenderUppercase: true,
            LetterSpacing: 0.5
          );
          Anchor: (Bottom: 24);
        }

        Group #SearchRow {
          LayoutMode: Left;
          Anchor: (Bottom: 21, Height: 66);

          Group #SearchWrapper {
            FlexWeight: 1;
            Anchor: (Height: 66);
            Background: (Color: #161e2b);
            Padding: (Full: 3);

            TextField #SearchInput {
              PlaceholderText: "Search pets...";
              Style: (
                FontSize: 22,
                TextColor: #d4dfe8
              );
              PlaceholderStyle: (
                TextColor: #4a5d75,
                FontSize: 22
              );
              Background: (Color: #00000000);
              Padding: (Horizontal: 27, Vertical: 18);
            }
          }
        }

        Group #Separator {
          Anchor: (Height: 2, Bottom: 0);
          Background: (Color: #1e2c3f);
        }
      }

      Group #PetListContainer {
        FlexWeight: 1;
        LayoutMode: TopScrolling;
        ScrollbarStyle: $C.@TranslucentScrollbarStyle;

        Group #PetColumns {
          LayoutMode: Left;
          Padding: (Horizontal: 9);

          Group #PetColumn0 {
            LayoutMode: Top;
            Anchor: (Width: 360);
            Padding: (Right: 9);
          }

          Group #PetColumn1 {
            LayoutMode: Top;
            Anchor: (Width: 360);
            Padding: (Horizontal: 9);
          }

          Group #PetColumn2 {
            LayoutMode: Top;
            Anchor: (Width: 360);
            Padding: (Left: 9);
          }
        }
      }

      Group #Footer {
        LayoutMode: Top;
        Anchor: (Top: 21, Height: 54);

        Group #FooterLine {
          Anchor: (Height: 2, Bottom: 0);
          Background: (Color: #1e2c3f);
        }

        Group {
          LayoutMode: Left;
          Anchor: (Top: 18);

          Group {
            FlexWeight: 1;
          }

          Label #PetCount {
            Text: "";
            Style: (
              FontSize: 16,
              TextColor: #6a7d94,
              VerticalAlignment: Center,
              RenderUppercase: true,
              LetterSpacing: 1.2
            );
          }
        }
      }
    }
  }
}

$C.@BackButton {}
