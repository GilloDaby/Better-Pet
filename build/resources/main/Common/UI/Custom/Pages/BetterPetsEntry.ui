$C = "../Common.ui";
Group {
  Anchor: (Width: 350, Height: 236, Bottom: 8);
  LayoutMode: Top;
  Padding: (Full: 8);
  Background: (TexturePath: "../Common/ContainerPanelPatch.png", Border: 8);

  Button #SpawnButton {
    Anchor: (Height: 186, Bottom: 8);
    LayoutMode: Top;
    Padding: (Horizontal: 12, Vertical: 10);
    Style: ButtonStyle(
      Default: (Background: (Color: #162338)),
      Hovered: (Background: (Color: #1c2d46)),
      Pressed: (Background: (Color: #142136))
    );

    Group {
      Anchor: (Height: 72);
      LayoutMode: CenterMiddle;

      Group #Icon {
        Anchor: (Width: 68, Height: 68);
        Background: (TexturePath: "Common/UI/WorldMap/MapMarkers/Player.png");
      }
    }

    Label #PetName {
      Text: "Pet";
      Anchor: (Height: 24);
      Style: (...$C.@DefaultLabelStyle, FontSize: 17, RenderBold: true, TextColor: #f2ebdb, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Label #PetCommand {
      Text: "Lvl 1 | P0 | Points 0";
      Anchor: (Height: 18);
      Style: (...$C.@DefaultLabelStyle, FontSize: 12, TextColor: #a9c0d8, HorizontalAlignment: Center, VerticalAlignment: Center);
    }

    Group #PetEffectsWrap {
      FlexWeight: 1;
      LayoutMode: Top;
      Padding: (Top: 6, Left: 6, Right: 6);

      Label #PetEffects {
        Text: "No bonus";
        FlexWeight: 1;
        Style: (...$C.@DefaultLabelStyle, FontSize: 11, TextColor: #9ee8d1, HorizontalAlignment: Center, VerticalAlignment: Center, Wrap: true);
      }
    }
  }

  $C.@SecondaryTextButton #UpgradeButton {
    @Anchor = (Height: 30);
    Text: "UPGRADE";
  }
}

